# Database — Supabase (primary) or local Docker (fallback)
# Option 1: Supabase — paste your connection string from Supabase dashboard
#   Settings → Database → Connection string → URI (use "Transaction" mode pooler for web apps)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Option 2: Local Docker (fallback) — run `docker compose up -d` from backend/
#   Falls back to this automatically if DATABASE_URL is not set.
DATABASE_URL=postgresql://netra:netra@localhost:5432/netra

# Sentinel camera grid — cctv.corp8.cloud
# HLS streams go through this CDN host (requires session cookie).
# RTSP/WebRTC go through CCTV_DIRECT_IP (requires email:password in URL).
CCTV_HOST=cctv.corp8.cloud
CCTV_DIRECT_IP=103.250.160.189

# Your registered email on the Sentinel portal
CCTV_EMAIL=you@example.com

# Access password (XXXX-XXXX-XXXX format, obtained from cctv.corp8.cloud/auth/register)
CCTV_PASSWORD=

# CORS — comma-separated allowed origins for browser requests. Defaults to
# the local Vite dev origin if unset. Add the hosted frontend's origin here
# once deployed (e.g. CORS_ORIGINS=http://localhost:5173,https://your-app.example.com).
CORS_ORIGINS=http://localhost:5173

# Demo login — gates the deployed frontend for judges. Unrelated to
# CCTV_EMAIL/CCTV_PASSWORD above (that's the vendor login the backend uses to
# fetch camera feeds; this is the account a judge types into netra's own
# login page). One seeded account, no user table - see app/routers/auth.py.
DEMO_EMAIL=judge@netra.demo
DEMO_PASSWORD=netra-demo
# Random opaque token returned on successful login. Generate a real one for
# any deployed environment: python -c "import secrets; print(secrets.token_hex(32))"
DEMO_TOKEN=netra-local-dev-token
