# Sentinel camera grid — cctv.corp8.cloud
# HLS streams go through this CDN host (requires session cookie).
# RTSP/WebRTC go through CCTV_DIRECT_IP (requires email:password in URL).
CCTV_HOST=cctv.corp8.cloud
